opam-version: "2.0"
name:         "mtbox"
maintainer:   "Romain Calascibetta <romain.calascibetta@gmail.com>"
authors:      "Romain Calascibetta <romain.calascibetta@gmail.com>"
homepage:     "https://github.com/robur-coop/mtbox"
bug-reports:  "https://github.com/robur-coop/mtbox/issues"
dev-repo:     "git+https://github.com/robur-coop/mtbox.git"
license:      "MIT"
synopsis:     "A set of tools for the Miou scheduler"

build: [ "dune" "build" "-p" name "-j" jobs ]
run-test: [ "dune" "runtest" "-p" name "-j" jobs ]

depends: [
  "ocaml"             {>= "5.1.0"}
  "dune"              {>= "3.13.0"}
  "miou"              {>= "0.8.0"}
  "fmt"
  "logs"
  "notty-miou"
  "nottui-miou"
  "duration"
  "cmdliner"
  "hdr_histogram"
]
x-maintenance-intent: [ "(latest)" ]
